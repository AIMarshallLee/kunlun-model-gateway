# Copy to a secret-managed deployment environment; never commit real values.
POSTGRES_DB=kunlun_gateway
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
KUNLUN_RUNTIME_DB_PASSWORD=
KUNLUN_MIGRATOR_DB_PASSWORD=
# Production requires hostname-verified TLS. These examples target Supabase;
# replace PROJECT_REF but keep the CA path inside the application image.
KUNLUN_RUNTIME_DATABASE_URL=postgresql+psycopg://kunlun_runtime:PERCENT_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt
KUNLUN_MIGRATOR_DATABASE_URL=postgresql+psycopg://kunlun_migrator:PERCENT_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt
PUBLIC_DOMAIN=
ACME_EMAIL=

KUNLUN_ENV=production
KUNLUN_DATABASE_URL=overridden_by_compose
KUNLUN_PUBLIC_SIGNUP=false
KUNLUN_ENABLE_TEST_PAYMENTS=false
KUNLUN_LIVE_PAYMENTS=false
KUNLUN_LIVE_UPSTREAM=false
KUNLUN_API_KEY_PEPPER=
KUNLUN_SESSION_PEPPER=
KUNLUN_IDENTITY_TOKEN_PEPPER=
KUNLUN_OPERATOR_SIGNING_SECRET=
KUNLUN_OPS_PRIVATE_ACCESS_ACKNOWLEDGED=false
# Self-hosted Compose: must match the fixed Caddy address.
KUNLUN_TRUSTED_PROXY_CIDRS=172.30.50.2/32
# Cloudflare Container: leave CIDRS empty and inject the same 32+ character
# Worker Secret into the Worker and Container. Never commit the real value.
KUNLUN_TRUSTED_PROXY_SECRET=
# Vercel Container: use the IPv4 Supavisor session pooler URL as
# KUNLUN_DATABASE_URL, set the explicit ingress profile, and inject a different
# 32+ character CRON_SECRET. Keep the direct migrator URL outside Vercel.
# KUNLUN_DATABASE_URL=postgresql+psycopg://kunlun_runtime.PROJECT_REF:PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt
KUNLUN_INGRESS_PROVIDER=
CRON_SECRET=
KUNLUN_RATE_LIMIT_PER_MINUTE=60
KUNLUN_CHECKOUT_RATE_LIMIT_PER_MINUTE=5
KUNLUN_MAX_OPEN_CHECKOUT_ORDERS=3
KUNLUN_MODEL_RESERVATION_LEASE_SECONDS=300

# Required before public signup can be enabled.
# Keep false for a private/staging deployment. Set true only with a tested
# SMTP delivery path and the selected CAPTCHA provider's browser widget.
KUNLUN_REQUIRE_EMAIL_VERIFICATION=false
KUNLUN_SMTP_URL=
KUNLUN_EMAIL_FROM=
KUNLUN_PUBLIC_BASE_URL=
KUNLUN_CAPTCHA_REQUIRED=false
# The bundled browser integration currently supports Cloudflare Turnstile.
# The site key is public; keep the secret only in the server-side secret store.
KUNLUN_CAPTCHA_PROVIDER=turnstile
KUNLUN_CAPTCHA_SITE_KEY=
KUNLUN_CAPTCHA_EXPECTED_HOSTNAME=
KUNLUN_CAPTCHA_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify
KUNLUN_CAPTCHA_SECRET=
KUNLUN_CAPTCHA_HOST_ALLOWLIST=challenges.cloudflare.com
KUNLUN_TERMS_URL=
KUNLUN_PRIVACY_URL=
KUNLUN_COMPLAINT_EMAIL=
KUNLUN_COMPLIANCE_ACKNOWLEDGED=false

# Required before public accounts can call real model providers.
KUNLUN_CONTENT_SAFETY_REQUIRED=false
KUNLUN_CONTENT_SAFETY_ENDPOINT=
KUNLUN_CONTENT_SAFETY_API_KEY=
KUNLUN_CONTENT_SAFETY_HOST_ALLOWLIST=
KUNLUN_CONTENT_SAFETY_POLICY_VERSION=
KUNLUN_PROVIDERS_JSON=[]
KUNLUN_PROVIDER_HOST_ALLOWLIST=
KUNLUN_MODELS_JSON=

# Required before live checkout can be enabled.
KUNLUN_PAYMENT_PROVIDER=
KUNLUN_PAYMENT_BRIDGE_ENDPOINT=
KUNLUN_PAYMENT_BRIDGE_MERCHANT_ID=
KUNLUN_PAYMENT_BRIDGE_SECRET=
KUNLUN_PAYMENT_BRIDGE_HOST_ALLOWLIST=
KUNLUN_PAYMENT_BRIDGE_OFFICIAL_SDK_ACKNOWLEDGED=false
KUNLUN_TOPUP_PACKAGES_JSON={}

# Operational access uses short-lived HMAC tokens minted by
# `python -m scripts.mint_ops_token`. KUNLUN_OPERATOR_TOKEN is retained only for
# development compatibility and must not be used by production.
# KUNLUN_OPERATOR_TOKEN=
