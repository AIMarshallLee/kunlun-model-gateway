{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kunlun-model-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "containers": [
    {
      "class_name": "GatewayContainer",
      "image": "./Dockerfile",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY_CONTAINER",
        "class_name": "GatewayContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewayContainer"]
    }
  ]
}
