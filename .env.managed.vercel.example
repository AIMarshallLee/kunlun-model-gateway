# Commercial gateway candidate. NOT ready to deploy unchanged.
# Keep secrets in approved environment storage; never commit a populated copy.
# No upstream API keys belong here: provision approved keys through platform Vault.
# Database URLs use independent role passwords and the image's readable CA path.
# Keep the migrator connection in a separate one-shot preflight environment, not Vercel.
KUNLUN_DATABASE_URL=
KUNLUN_VAULT_EXECUTOR_DATABASE_URL=
KUNLUN_ENV=production
KUNLUN_GATEWAY_MODE=managed_gateway
KUNLUN_VAULT_BACKEND=supabase_vault

# These defaults deliberately FAIL managed production startup and launch checks.
# Enable each capability only after the corresponding external approval/acceptance.
KUNLUN_PUBLIC_SIGNUP=false
KUNLUN_LIVE_PAYMENTS=false
KUNLUN_LIVE_UPSTREAM=false
KUNLUN_ENABLE_TEST_PAYMENTS=false
KUNLUN_PLATFORM_DAILY_BUDGET_MICROUSD=0
KUNLUN_SUPPLIER_USE_ACKNOWLEDGED=false
KUNLUN_PROVIDERS_JSON=[]
KUNLUN_PROVIDER_HOST_ALLOWLIST=
KUNLUN_MODELS_JSON=

# Persist independent application secrets; do not rotate existing peppers casually.
KUNLUN_API_KEY_PEPPER=
KUNLUN_SESSION_PEPPER=
KUNLUN_IDENTITY_TOKEN_PEPPER=
KUNLUN_OPERATOR_SIGNING_SECRET=
KUNLUN_OPS_PRIVATE_ACCESS_ACKNOWLEDGED=false
KUNLUN_INGRESS_PROVIDER=vercel
KUNLUN_TRUSTED_PROXY_CIDRS=
KUNLUN_TRUSTED_PROXY_SECRET=
KUNLUN_OPS_INGRESS_SECRET=
CRON_SECRET=

# Customer identity and browser CAPTCHA. SMTP/captcha acceptance is external.
KUNLUN_REQUIRE_EMAIL_VERIFICATION=true
KUNLUN_SMTP_URL=
KUNLUN_EMAIL_FROM=
KUNLUN_PUBLIC_BASE_URL=
KUNLUN_CAPTCHA_REQUIRED=true
KUNLUN_CAPTCHA_PROVIDER=turnstile
KUNLUN_CAPTCHA_SITE_KEY=
KUNLUN_CAPTCHA_EXPECTED_HOSTNAME=
KUNLUN_CAPTCHA_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify
KUNLUN_CAPTCHA_SECRET=
KUNLUN_CAPTCHA_HOST_ALLOWLIST=challenges.cloudflare.com
KUNLUN_TERMS_URL=
KUNLUN_PRIVACY_URL=
KUNLUN_COMPLAINT_EMAIL=
KUNLUN_COMPLIANCE_ACKNOWLEDGED=false

# Independently operated content-safety adapter; no permit-all default.
KUNLUN_CONTENT_SAFETY_REQUIRED=true
KUNLUN_CONTENT_SAFETY_ENDPOINT=
KUNLUN_CONTENT_SAFETY_API_KEY=
KUNLUN_CONTENT_SAFETY_HOST_ALLOWLIST=
KUNLUN_CONTENT_SAFETY_POLICY_VERSION=

# Existing bridge contract only. A filled field/ack is NOT official SDK evidence.
# Do not invent a provider, merchant, SKU or real price to make startup pass.
KUNLUN_PAYMENT_PROVIDER=
KUNLUN_PAYMENT_BRIDGE_ENDPOINT=
KUNLUN_PAYMENT_BRIDGE_MERCHANT_ID=
KUNLUN_PAYMENT_BRIDGE_SECRET=
KUNLUN_PAYMENT_BRIDGE_HOST_ALLOWLIST=
KUNLUN_PAYMENT_BRIDGE_OFFICIAL_SDK_ACKNOWLEDGED=false
KUNLUN_TOPUP_PACKAGES_JSON={}

KUNLUN_RATE_LIMIT_PER_MINUTE=60
KUNLUN_CHECKOUT_RATE_LIMIT_PER_MINUTE=5
KUNLUN_MAX_OPEN_CHECKOUT_ORDERS=3
KUNLUN_MODEL_RESERVATION_LEASE_SECONDS=300
KUNLUN_MAX_ACTIVE_API_KEYS=5
KUNLUN_MAX_OUTPUT_TOKENS=4096
KUNLUN_DEFAULT_OUTPUT_TOKENS=256
