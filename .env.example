# Kunlun Gateway development template. Copy to .env for local use only.
KUNLUN_ENV=development
KUNLUN_DATABASE_URL=sqlite:///./kunlun-gateway.sqlite3

# All three switches are deliberately off by default.
KUNLUN_PUBLIC_SIGNUP=false
KUNLUN_ENABLE_TEST_PAYMENTS=false
KUNLUN_LIVE_UPSTREAM=false
KUNLUN_LIVE_PAYMENTS=false

# Required only when test payments are explicitly enabled. Never commit real secrets.
KUNLUN_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
KUNLUN_API_KEY_PEPPER=replace-with-a-stable-64-character-secret
KUNLUN_SESSION_PEPPER=replace-with-a-stable-64-character-secret
# Optional alternative to a fixed trusted proxy /32. Used by the Cloudflare
# Worker wrapper and always injected as a secret, never committed.
KUNLUN_TRUSTED_PROXY_SECRET=
# Required before live upstream is enabled; protects manual reconciliation.
KUNLUN_OPERATOR_TOKEN=replace-with-a-separate-64-character-operator-secret

KUNLUN_RATE_LIMIT_PER_MINUTE=60
KUNLUN_CHECKOUT_RATE_LIMIT_PER_MINUTE=5
KUNLUN_MAX_OPEN_CHECKOUT_ORDERS=3
KUNLUN_MODEL_RESERVATION_LEASE_SECONDS=300
KUNLUN_MAX_OUTPUT_TOKENS=4096
KUNLUN_DEFAULT_OUTPUT_TOKENS=256
KUNLUN_PROVIDERS_JSON=[]
KUNLUN_PROVIDER_HOST_ALLOWLIST=
# Example only; prices are integer microUSD per one million tokens.
# Production live upstream requires this explicit catalog and complete pricing
# for every routed model in every provider entry.
# KUNLUN_MODELS_JSON={"model-a":{"input_microusd_per_million":1000000,"output_microusd_per_million":1000000,"max_output_tokens":4096}}

# Required by production validation when public signup is enabled.
KUNLUN_TERMS_URL=
KUNLUN_PRIVACY_URL=
KUNLUN_COMPLAINT_EMAIL=
KUNLUN_COMPLIANCE_ACKNOWLEDGED=false

# Example provider secrets are referenced by name from KUNLUN_PROVIDERS_JSON.
# KUNLUN_PROVIDER_A_KEY=
# KUNLUN_PROVIDER_B_KEY=
