# Vercel Container environment template. Store real values in Vercel's
# encrypted Environment Variables; never commit a populated copy.
# Use the external Supabase project already passed the three-connection
# preflight. Keep the migrator URL outside Vercel and use separate passwords
# for the runtime and Vault executor roles.
KUNLUN_DATABASE_URL=postgresql+psycopg://kunlun_runtime.PROJECT_REF:PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt
KUNLUN_VAULT_EXECUTOR_DATABASE_URL=postgresql+psycopg://kunlun_vault_executor.PROJECT_REF:DIFFERENT_PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-prod-ca-2021.crt

# Production BYOK boundary. Public signup, payments/recharge and shared
# upstream keys remain disabled.
KUNLUN_ENV=production
KUNLUN_GATEWAY_MODE=byok
KUNLUN_VAULT_BACKEND=supabase_vault
KUNLUN_PUBLIC_SIGNUP=false
KUNLUN_ENABLE_TEST_PAYMENTS=false
KUNLUN_LIVE_PAYMENTS=false
KUNLUN_LIVE_UPSTREAM=false
KUNLUN_TOPUP_PACKAGES_JSON={}

# Populate these three catalog values from currently verified official
# provider documentation. They contain allowlists/prices only, never API keys.
KUNLUN_PROVIDERS_JSON=[]
KUNLUN_PROVIDER_HOST_ALLOWLIST=
KUNLUN_MODELS_JSON=

# Vercel ingress profile (four settings). Vercel has no fixed client-IP CIDR.
KUNLUN_INGRESS_PROVIDER=vercel
KUNLUN_TRUSTED_PROXY_CIDRS=
KUNLUN_TRUSTED_PROXY_SECRET=
KUNLUN_OPS_INGRESS_SECRET=

# Cron and application secrets are independent values.
CRON_SECRET=
KUNLUN_OPERATOR_SIGNING_SECRET=
KUNLUN_API_KEY_PEPPER=
KUNLUN_SESSION_PEPPER=
KUNLUN_IDENTITY_TOKEN_PEPPER=
KUNLUN_OPS_PRIVATE_ACCESS_ACKNOWLEDGED=true

# Optional tuning; defaults are shown so the deployed limits are explicit.
KUNLUN_RATE_LIMIT_PER_MINUTE=60
KUNLUN_CHECKOUT_RATE_LIMIT_PER_MINUTE=5
KUNLUN_MAX_OPEN_CHECKOUT_ORDERS=3
KUNLUN_MODEL_RESERVATION_LEASE_SECONDS=300
